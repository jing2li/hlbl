# Two chains on random fields (ctest hypercube_random_fields_multi and
# hypercube_dummy_run).
random_fields   = yes
lattice         = 6,6,6,6
procs           = 1,1,1,1
cache           = host
out             = hypercube_random_fields_multi.h5
muon_mass       = 105.6583745   # MeV
lattice_spacing = 0.07957       # fm

# windows 0 and 1: 16 + 15 propagators, 15 + 65 = 80 pairs
chain start=0,0,0,0 dir=1,1,1,1  stride=1 steps=1
# windows 0 to 2: 15 + 65 + 65 = 145 pairs
chain start=3,0,0,0 dir=1,-1,1,1 stride=1 steps=2
