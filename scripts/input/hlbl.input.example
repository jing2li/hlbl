# Input file of hlbl_hypercube:  srun hlbl_hypercube --in hlbl.input
#
# The chains run one after the other, after one gauge read and multigrid
# setup. Global lines are `key = value`, chain lines `chain key=value ...` with
# vectors t,x,y,z. Every key is required unless marked optional.
#
# Check before submitting:
#   python3.11 scripts/hlbl_mII_hypercube_schedule.py --in hlbl.input \
#       --t-invert 40.6 --t-kernel-sum 2.8      # counts, overlaps, memory, cost; no GPU
#   srun hlbl_hypercube --in hlbl.input --dummy-run --tune   # on the job's resources

# ---- geometry: must match invert.input (a run stops if it does not) -------
lattice = 128,64,64,64
procs   = 4,2,2,2

# ---- physics --------------------------------------------------------------
muon_mass       = 105.6583745   # MeV
lattice_spacing = 0.07957       # fm (cB211a.072.64)

# ---- run --------------------------------------------------------------------
cache  = host                  # device | host: where the propagators are kept
out    = result.h5             # result file
# timing = result.timing.csv   # optional; default: <out> with .timing.csv
# random_fields = yes          # optional: random numbers on lattice/procs, no solver

# ---- chains -----------------------------------------------------------------
# start    first source, global coordinates
# dir      step direction, a sign vector (+-1,+-1,+-1,+-1)
# stride   n: every pair has |y| = 2n
# steps    optional; K: windows 0..K. Default auto: as many as fit before
#          sources wrap
#
# To resume a chain whose windows 0..j are in the result file, start a new
# chain at start + j*stride*dir with steps K - j (see the README).

chain start=0,0,0,0    dir=1,1,1,1   stride=4 steps=30
chain start=32,0,0,0   dir=1,-1,1,1  stride=4 steps=30
chain start=0,16,0,0   dir=1,1,1,1   stride=6

# ---- 2+2 (optional) ---------------------------------------------------------
# 2p2 source=t,x,y,z targets=(t,x,y,z),(t,x,y,z),...
#   right after the first solve of `source` in the run, its 2+2 pieces (P1,
#   and P2_0, P2_1, P3 for every target), then its pairs as usual. One line
#   per source; sites in [0, L). The source must be solved by a chain; a pair
#   {A,B} needs A with target B and B with target A (see the README).
# 2p2 source=4,4,4,4 targets=(8,8,8,8),(0,0,0,0)
# 2p2 source=8,8,8,8 targets=(4,4,4,4)
